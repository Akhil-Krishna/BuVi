{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "QueryColumnResponse": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "title": "QueryColumnResponse",
        "type": "object"
      },
      "QueryRequest": {
        "additionalProperties": false,
        "description": "Section 13's request body.",
        "properties": {
          "database_id": {
            "format": "uuid",
            "title": "Database Id",
            "type": "string"
          },
          "max_rows": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Rows"
          },
          "purpose": {
            "enum": [
              "analytics_run",
              "sql_editor",
              "export"
            ],
            "title": "Purpose",
            "type": "string"
          },
          "run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "sql": {
            "maxLength": 100000,
            "minLength": 1,
            "title": "Sql",
            "type": "string"
          },
          "timeout_ms": {
            "anyOf": [
              {
                "minimum": 100.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timeout Ms"
          }
        },
        "required": [
          "database_id",
          "sql",
          "purpose"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "QueryResponse": {
        "properties": {
          "bytes_returned": {
            "title": "Bytes Returned",
            "type": "integer"
          },
          "columns": {
            "items": {
              "$ref": "#/components/schemas/QueryColumnResponse"
            },
            "title": "Columns",
            "type": "array"
          },
          "duration_ms": {
            "title": "Duration Ms",
            "type": "integer"
          },
          "query_id": {
            "format": "uuid",
            "title": "Query Id",
            "type": "string"
          },
          "result_expires_at": {
            "format": "date-time",
            "title": "Result Expires At",
            "type": "string"
          },
          "result_handle": {
            "title": "Result Handle",
            "type": "string"
          },
          "row_count": {
            "title": "Row Count",
            "type": "integer"
          },
          "rows": {
            "items": {
              "items": {},
              "type": "array"
            },
            "title": "Rows",
            "type": "array"
          },
          "status": {
            "const": "succeeded",
            "title": "Status",
            "type": "string"
          },
          "tables": {
            "items": {
              "type": "string"
            },
            "title": "Tables",
            "type": "array"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          },
          "truncation_reason": {
            "anyOf": [
              {
                "enum": [
                  "rows",
                  "bytes"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Truncation Reason"
          }
        },
        "required": [
          "query_id",
          "status",
          "columns",
          "rows",
          "row_count",
          "truncated",
          "truncation_reason",
          "bytes_returned",
          "duration_ms",
          "tables",
          "result_handle",
          "result_expires_at"
        ],
        "title": "QueryResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "SQL validation, read-only execution, result handles and query audit (Section 13).",
    "title": "query-gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/internal/v1/queries": {
      "post": {
        "operationId": "run_query_internal_v1_queries_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Query",
        "tags": [
          "internal"
        ]
      }
    }
  }
}
