      "ConnectionSecretRequest": {
        "additionalProperties": false,
        "description": "Credentials, written to Vault and never returned (Section 13.1).",
        "properties": {
          "host": {
            "maxLength": 253,
            "minLength": 1,
            "title": "Host",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "port": {
            "default": 5432,
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Port",
            "type": "integer"
          },
          "sslmode": {
            "default": "require",
            "enum": [
              "disable",
              "require",
              "verify-full"
            ],
            "title": "Sslmode",
            "type": "string"
          },
          "username": {
            "maxLength": 63,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "host",
          "username",
          "password"
        ],
        "title": "ConnectionSecretRequest",
        "type": "object"
      },
      "ConnectivityTestResponse": {
        "description": "Sanitized: a stable code and a fixed message, never driver text (Section 13.1).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "data_source_id": {
            "format": "uuid",
