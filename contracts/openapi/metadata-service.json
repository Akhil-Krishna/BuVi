        "parameters": [
          {
            "in": "path",
            "name": "data_source_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Data Source Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
